<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.secondhand.mapper.CarouselMapper">

    <resultMap id="BaseResultMap" type="com.secondhand.entity.Carousel">
        <id column="carousel_id" property="carouselId"/>
        <result column="title" property="title"/>
        <result column="image_url" property="imageUrl"/>
        <result column="link_url" property="linkUrl"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="BaseColumns">
        carousel_id, title, image_url, link_url, sort_order, status, create_time, update_time
    </sql>

    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM carousel
        WHERE carousel_id = #{carouselId}
    </select>

    <select id="findByStatus" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM carousel
        WHERE status = #{status}
        ORDER BY sort_order ASC, create_time DESC
    </select>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM carousel
        ORDER BY sort_order ASC, create_time DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="carouselId">
        INSERT INTO carousel (title, image_url, link_url, sort_order, status)
        VALUES (#{title}, #{imageUrl}, #{linkUrl}, #{sortOrder}, #{status})
    </insert>

    <update id="update">
        UPDATE carousel
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="linkUrl != null">link_url = #{linkUrl},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null">status = #{status},</if>
            update_time = NOW()
        </set>
        WHERE carousel_id = #{carouselId}
    </update>

    <delete id="deleteById">
        DELETE FROM carousel WHERE carousel_id = #{carouselId}
    </delete>

</mapper>