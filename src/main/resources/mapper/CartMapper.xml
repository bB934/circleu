<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.secondhand.mapper.CartMapper">

    <resultMap id="BaseResultMap" type="com.secondhand.entity.Cart">
        <id column="cart_id" property="cartId"/>
        <result column="user_id" property="userId"/>
        <result column="goods_id" property="goodsId"/>
        <result column="num" property="num"/>
        <result column="price" property="price"/>
        <result column="price_ago" property="priceAgo"/>
        <result column="state" property="state"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="BaseColumns">
        cart_id, user_id, goods_id, num, price, price_ago, state, create_time, update_time
    </sql>

    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM cart
        WHERE cart_id = #{cartId}
    </select>

    <select id="findByUserIdAndGoodsId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM cart
        WHERE user_id = #{userId} AND goods_id = #{goodsId}
        LIMIT 1
    </select>

    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM cart
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <select id="findByIds" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM cart
        WHERE cart_id IN
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="cartId">
        INSERT INTO cart (user_id, goods_id, num, price, price_ago, state)
        VALUES (#{userId}, #{goodsId}, #{num}, #{price}, #{priceAgo}, #{state})
    </insert>

    <update id="update">
        UPDATE cart
        <set>
            <if test="goodsId != null">goods_id = #{goodsId},</if>
            <if test="num != null">num = #{num},</if>
            <if test="price != null">price = #{price},</if>
            <if test="priceAgo != null">price_ago = #{priceAgo},</if>
            <if test="state != null">state = #{state},</if>
            update_time = NOW()
        </set>
        WHERE cart_id = #{cartId}
    </update>

    <delete id="deleteById">
        DELETE FROM cart WHERE cart_id = #{cartId}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM cart WHERE user_id = #{userId}
    </delete>

</mapper>